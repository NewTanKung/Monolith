DATABASE_URL="postgresql://monolith:monolith_local_dev@localhost:55432/monolith"
# local/test: development or test. Production MUST set production.
APP_ENV=development
HUB_URL=http://localhost:3000
# Production example: .example.com, Hub https://hub.example.com
SESSION_COOKIE_DOMAIN=
ALLOW_REGISTRATION=true
# local: mailpit; production: resend
MAIL_PROVIDER=mailpit
MAILPIT_URL=http://127.0.0.1:8025
MAIL_FROM="Monolith <noreply@monolith.test>"
# Server secret, required with MAIL_PROVIDER=resend. Never commit a real key.
RESEND_API_KEY=
