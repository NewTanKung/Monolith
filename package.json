{
  "name": "monolith-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Monolith Hub - Central Hub & App Launcher for Lifestyle, Work, and Gaming with SSO",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate": "prisma generate --schema=apps/hub/prisma/schema.prisma",
    "build:packages": "npm run build --workspace=@monolith/auth-client",
    "predev:hub": "npm run generate && npm run build:packages",
    "dev:hub": "npm run dev --workspace=@monolith/hub",
    "predev:demo": "npm run build:packages",
    "dev:demo": "npm run dev --workspace=@monolith/demo-sub-app",
    "prebuild": "npm run generate && npm run build:packages",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
